{
    "name": "appnave/nave-minutas-iss",
    "description": "This is my package iss-juridico",
    "keywords": [
        "bildvitta",
        "laravel",
        "iss-juridico"
    ],
    "homepage": "https://github.com/appnave/nave-minutas-iss",
    "license": "MIT",
    "authors": [
        {
            "name": "App Nave",
            "email": "contato@nave.app.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.4.3",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^5.10",
        "orchestra/testbench": "^6.22",
        "pestphp/pest": "^1.21",
        "pestphp/pest-plugin-laravel": "^1.1",
        "phpunit/phpunit": "^9.5",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Bildvitta\\IssJuridico\\": "src",
            "Bildvitta\\IssJuridico\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bildvitta\\IssJuridico\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bildvitta\\IssJuridico\\IssJuridicoServiceProvider"
            ],
            "aliases": {
                "IssJuridico": "Bildvitta\\IssJuridico\\Facades\\IssJuridico"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "check-style": [
            "vendor/bin/pint --test"
        ],
        "fix-style": [
            "vendor/bin/pint"
        ]
    }
}